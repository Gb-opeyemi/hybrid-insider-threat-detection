<group name="thesis_insider,m02,">

  <!-- M02: Individual incorrect-password failure -->
  <rule id="100200" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <field name="win.eventdata.subStatus" type="pcre2">(?i)^0xc000006a$</field>
    <description>THESIS M02: Incorrect password for $(win.eventdata.targetUserName)</description>
    <group>thesis_m02,authentication_failed,</group>
  </rule>

  <!-- M02: Repeated incorrect-password failures -->
  <rule id="100201" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>THESIS M02: Repeated incorrect passwords for $(win.eventdata.targetUserName)</description>
    <group>thesis_m02,insider_threat,</group>
  </rule>

</group>
