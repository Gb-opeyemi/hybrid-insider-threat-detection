<group name="thesis_insider,m01,">

  <!-- M01: Denied SMB access across monitored shares -->
  <rule id="100100" level="5">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^5145$</field>
    <description>THESIS M01: SMB access denied for $(win.eventdata.subjectUserName)</description>
    <group>thesis_m01,access_denied,</group>
  </rule>

  <!-- M01: Repeated access denials by the same account -->
  <rule id="100101" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.subjectUserName</same_field>
    <description>THESIS M01: Repeated SMB access denials by $(win.eventdata.subjectUserName)</description>
    <group>thesis_m01,insider_threat,</group>
  </rule>

</group>
