<!-- Template uses a documentation-only endpoint. Render with lab.local.json before use. -->
<group name="thesis_insider,m05,">

  <rule id="100501" level="10">
    <if_sid>61603</if_sid>

    <field name="win.eventdata.image" type="pcre2">(?i)\\sftp\.exe$</field>

    <field name="win.eventdata.commandLine" type="pcre2">(?i)m05receiver@198\.51\.100\.20</field>

    <description>THESIS M05: Suspicious SFTP transfer initiated by $(win.eventdata.user) to the designated research-data destination.</description>

    <group>thesis_m05,suspicious_sftp_transfer,</group>
  </rule>

</group>
