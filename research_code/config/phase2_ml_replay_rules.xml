<!-- NEW file: /var/ossec/etc/rules/thesis_ml_replay_rules.xml.
     Proposed IDs: verify they are unused before installation. -->
<group name="thesis_ml,controlled_replay,">
  <rule id="110500" level="0">
    <decoded_as>json</decoded_as>
    <location type="pcre2">^/var/log/thesis-ml/predictions\.jsonl$</location>
    <field name="event_type" type="pcre2">^thesis_ml_prediction$</field>
    <field name="schema_version" type="pcre2">^1$</field>
    <field name="mode" type="pcre2">^controlled_replay$</field>
    <field name="historical_replay" type="pcre2">^true$</field>
    <description>Controlled historical ML replay record.</description>
  </rule>
  <rule id="110501" level="5">
    <if_sid>110500</if_sid>
    <field name="classification" type="pcre2">^malicious$</field>
    <description>HISTORICAL REPLAY DEMONSTRATION: ML classified completed activity as malicious; user=$(username), probability=$(malicious_probability), synthetic=$(synthetic). Not a live incident.</description>
  </rule>
  <rule id="110502" level="3">
    <if_sid>110500</if_sid>
    <field name="classification" type="pcre2">^benign$</field>
    <description>HISTORICAL REPLAY DEMONSTRATION: ML classified completed activity as benign; user=$(username), synthetic=$(synthetic). Not a live incident.</description>
  </rule>
</group>
