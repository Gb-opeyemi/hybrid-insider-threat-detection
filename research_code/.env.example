# Model selector: development CLIs use environment > .env > RF.
# The scheduled model-aware launcher deliberately reads project .env directly.
# Copy to .env locally; .env is ignored. Do not put credentials in this example.
THESIS_HYBRID_MODEL=random_forest
# The other accepted value is tabpfn. Selection never enables publication.

# Optional PROCESS environment settings (not loaded from this .env by the selector):
# THESIS_LAB_CONFIG=config/lab.local.json
# THESIS_ARTIFACT_BUNDLE=artifacts/frozen_baseline
